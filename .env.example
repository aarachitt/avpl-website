# ─────────────────────────────────────────────────────────────
# AVPL Website — Environment Configuration
# Copy this file to .env.local for local development, or set
# these as environment variables in your hosting provider.
# NEVER commit a real .env / .env.local file.
# ─────────────────────────────────────────────────────────────

# --- Site -------------------------------------------------------
# Public base URL, used for canonical tags, OG images, sitemap.
NEXT_PUBLIC_SITE_URL=https://www.aarachittventures.com

# --- AI (shared by the AI Assistant chat AND the AI Campaign Builder) ---
# "fallback" = no external AI calls. The Campaign Builder uses a
#   deterministic, zero-cost blueprint generator; the conversational
#   AI Assistant shows an honest "being connected" state instead of a
#   fake chatbot (never simulated — see brief §12). This is the
#   current default per project decision.
# "anthropic" = calls the Claude Messages API server-side for both
#   features. Required for the AI Assistant to hold real conversations.
AI_PROVIDER=fallback

# Required only if AI_PROVIDER=anthropic.
# Get a key at https://console.anthropic.com — NEVER expose this
# to the browser; it is read only inside server-side API routes.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Lead delivery (Contact form, Partnership form, Campaign Builder handoff) ---
# "resend" (recommended) or "smtp".
EMAIL_PROVIDER=resend

# Required if EMAIL_PROVIDER=resend. Get a key at https://resend.com
RESEND_API_KEY=

# Required if EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# REQUIRED before any form can deliver a lead — no fallback value is
# provided in code, deliberately: AVPL's real email is a launch
# blocker (see LAUNCH_CHECKLIST.md), and guessing one would risk
# silently misdelivering real customer/partner inquiries.
# Sender identity must be a verified domain/sender for your provider.
LEADS_FROM_EMAIL=
# Where lead notifications are delivered. Comma-separate for multiple.
LEADS_TO_EMAIL=

# --- Spam protection ----------------------------------------------
# Optional: Cloudflare Turnstile site/secret keys. If unset, forms
# fall back to the built-in honeypot + timing check only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting --------------------------------------------------
# Max submissions/messages allowed per IP within the window below.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
