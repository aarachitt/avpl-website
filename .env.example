# ─────────────────────────────────────────────────────────────
# AVPL Website — Environment Configuration
# Copy this file to .env.local for local development, or set
# these as environment variables in your hosting provider.
# NEVER commit a real .env / .env.local file.
# ─────────────────────────────────────────────────────────────

# --- Site -------------------------------------------------------
# Public base URL, used for canonical tags, OG images, sitemap.
NEXT_PUBLIC_SITE_URL=https://www.aarachittventures.com

# --- AI Campaign Builder -----------------------------------------
# "fallback" = deterministic, on-device blueprint generator (no
#   external API calls, no cost, always available — current default
#   per project decision). Safe for local dev and for production
#   until a real AI credential is supplied.
# "anthropic" = calls the Claude Messages API server-side.
AI_PROVIDER=fallback

# Required only if AI_PROVIDER=anthropic.
# Get a key at https://console.anthropic.com — NEVER expose this
# to the browser; it is read only inside server-side API routes.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for blueprint generation.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Lead delivery (Contact form + Campaign Builder handoff) ----
# "resend" (recommended) or "smtp".
EMAIL_PROVIDER=resend

# Required if EMAIL_PROVIDER=resend. Get a key at https://resend.com
RESEND_API_KEY=

# Required if EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Sender identity (must be a verified domain/sender for your provider).
LEADS_FROM_EMAIL=leads@aarachittventures.com
# Where lead notifications are delivered. Comma-separate for multiple.
LEADS_TO_EMAIL=hello@aarachittventures.com

# --- Spam protection ----------------------------------------------
# Optional: Cloudflare Turnstile site/secret keys. If unset, the
# form falls back to the built-in honeypot + timing check only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting --------------------------------------------------
# Max form submissions allowed per IP within the window below.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
